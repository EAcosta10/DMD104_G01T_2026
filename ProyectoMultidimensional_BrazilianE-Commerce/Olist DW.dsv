  <Schema>
    <xs:schema id="Olist_x0020_DW" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
      <xs:element name="Olist_x0020_DW" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msprop:design-time-name="23a02e15-3ac8-41f5-9a68-cc0abda11109">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Dim_Productos" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:design-time-name="e971d53f-f849-4674-b6e1-81283e937806" msprop:QueryDefinition="SELECT    p.product_id, ISNULL(t.product_category_name_english, N'Unknown Category') AS Categoria, p.product_weight_g AS Peso_g, p.product_length_cm AS Largo_cm, p.product_height_cm AS Alto_cm, &#xD;&#xA;                      p.product_width_cm AS Ancho_cm&#xD;&#xA;FROM         Products AS p LEFT OUTER JOIN&#xD;&#xA;                      ProductCategoryTranslation AS t ON p.product_category_name = t.product_category_name" msprop:FriendlyName="Dim_Productos" msprop:TableType="View" msprop:DbTableName="Dim_Productos" msprop:Description="">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="product_id" msprop:FriendlyName="product_id" msprop:DbColumnName="product_id" msprop:design-time-name="7c8032db-528e-49d1-9532-9027d18fd5f5">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="32" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="Categoria" msdata:ReadOnly="true" msprop:FriendlyName="Categoria" msprop:DbColumnName="Categoria" msprop:design-time-name="e4a7f0c0-518d-42a4-a22a-d99fb802a27c" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="100" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
