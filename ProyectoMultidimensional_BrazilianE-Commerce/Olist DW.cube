  <Source dwd:design-time-name="03eac38d-ebad-4717-99db-bbb3d20c8850">
    <DataSourceViewID>Olist DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="14b3cd18-e3f9-4293-9dec-f0727e9e1c0d">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="72178f05-59b2-4ec8-b125-04947593fbfd">
      <ID>KPI</ID>
      <Name>KPI Ventas Totales</Name>
      <Value>[Measures].[Monto Total Linea]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="f540d359-d458-4be8-bb33-ceb76adf2c96">
      <ID>KPI 1</ID>
      <Name>KPI Recuento Ventas</Name>
      <Value>[Measures].[Recuento Fact Ventas y Logistica]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="3390c6d7-2227-4d7a-b58c-74a4bd08a568">
      <ID>KPI 2</ID>
      <Name>KPI Calificacion Promedio</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Reseñas] = 0,
    NULL,
    CDBL([Measures].[Calificacion]) / CDBL([Measures].[Recuento Fact Reseñas])
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="4390467c-8ace-4721-90dd-dcec5f439946">
      <ID>KPI 4</ID>
      <Name>KPI Entregas Tardias</Name>
      <Value>[Measures].[Es Entrega Tardia]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="aae8a69f-d3b2-4726-8c9a-b1efe28add88">
      <ID>KPI 5</ID>
      <Name>KPI Porcentaje Entregas Tardias</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Es Entrega Tardia]
    / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="245999b9-3a35-4690-85e3-a68f7ebeadbd">
      <ID>KPI 6</ID>
      <Name>KPI Cuotas Promedio</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Pagos] = 0,
    NULL,
    [Measures].[Cuotas] / [Measures].[Recuento Fact Pagos]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="b32bec7b-b3c5-49af-8506-2cc59f1f07bd">
      <ID>KPI 7</ID>
      <Name>KPI Tasa de Flete</Name>
      <Value>IIF(
    [Measures].[Monto Total Linea] = 0,
    NULL,
    [Measures].[Valor Flete] / [Measures].[Monto Total Linea]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="38d80c76-02d0-4a32-a0de-dee3a89cbcb4">
      <ID>KPI 8</ID>
      <Name>KPI Total de Pedidos</Name>
      <Value>[Measures].[Recuento Fact Ventas y Logistica]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="79bd84ba-b8d5-4733-bb54-e5cd72527b61">
      <ID>KPI 9</ID>
      <Name>KPI Tiempo Promedio de Entrega</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Dias Total Entrega] / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="f83d9ec2-ab47-4735-a364-b245c21580bc">
      <ID>KPI 10</ID>
      <Name>KPI Dias Despacho Vendedor</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Dias Despacho Vendedor] / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="2bf59810-d58f-4cf0-940d-5f4a9424ef57">
      <ID>KPI 3</ID>
      <Name>KPI Total Clientes</Name>
      <Value>COUNT(
    NONEMPTY(
        [Dim Clientes].[Customer Id].[Customer Id].Members,
        [Measures].[Recuento Fact Ventas y Logistica]
    )
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="c77a7e4d-a9b1-4dbe-8158-607711363c5b">
      <ID>KPI 11</ID>
      <Name>KPI Total Vendedores</Name>
      <Value>COUNT(
    NONEMPTY(
        [Dim Vendedores].[Seller Id].[Seller Id].Members,
        [Measures].[Recuento Fact Ventas y Logistica]
    )
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="807ca290-b12b-4867-9972-126f52825c1d">
      <ID>KPI 12</ID>
      <Name>KPI Promedio de Ventas por Vendedor</Name>
      <Value>IIF(
    COUNT(NONEMPTY([Dim Vendedores].[Seller Id].[Seller Id].Members, [Measures].[Recuento Fact Ventas y Logistica])) = 0,
    NULL,
    [Measures].[Monto Total Linea] / COUNT(NONEMPTY([Dim Vendedores].[Seller Id].[Seller Id].Members, [Measures].[Recuento Fact Ventas y Logistica]))
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>