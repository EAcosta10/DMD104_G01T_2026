          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="924db5e9-199c-4354-968d-393e9adbf99d">
          <CubeDimensionID>Dim Tiempo</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="ddef0cb3-efc5-4336-8735-43006c35e705">
              <AttributeID>Fecha ID</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="634acb8a-a81b-4a85-b149-d74c600a7195">
                  <DataType>WChar</DataType>
                  <DataSize>10</DataSize>
                  <NullProcessing>UnknownMember</NullProcessing>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="4979587f-fc90-4cae-984c-5a67ce3beda4">
                    <TableID>Fact_Reseñas</TableID>
