  <Source dwd:design-time-name="95d1896a-bc37-4d04-84b0-622503edad99">
    <DataSourceViewID>Olist DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="6ee1f8d9-0f09-4159-ad75-e78f78bff152">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="538a5b01-d34e-422d-a334-8a4031077e72">
      <ID>KPI</ID>
      <Name>KPI Ventas Totales</Name>
      <Value>[Measures].[Monto Total Linea]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="0c2fcdd4-0e27-4a14-8d81-93f0031bf0f3">
      <ID>KPI 1</ID>
      <Name>KPI Recuento Ventas</Name>
      <Value>[Measures].[Recuento Fact Ventas y Logistica]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="0f136aa5-20b2-41fa-9e6e-7df6a96c4c8d">
      <ID>KPI 2</ID>
      <Name>KPI Calificacion Promedio</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Reseñas] = 0,
    NULL,
    (
        ([Measures].[Calificacion], [Dim Productos].[Product Id].CurrentMember) 
        / [Measures].[Recuento Fact Reseñas]
    ) * 5 * 100
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="621d4304-2a01-4a52-a3b4-a66a474369f5">
      <ID>KPI 4</ID>
      <Name>KPI Entregas Tardias</Name>
      <Value>[Measures].[Es Entrega Tardia]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="985bd282-1d3e-439b-a96b-d2c59a03a2eb">
      <ID>KPI 5</ID>
      <Name>KPI Porcentaje Entregas Tardias</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Es Entrega Tardia]
    / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="3d17ec2f-7b27-4c66-ad8d-ccfacd4c2c35">
      <ID>KPI 6</ID>
      <Name>KPI Cuotas Promedio</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Pagos] = 0,
    NULL,
    [Measures].[Cuotas] / [Measures].[Recuento Fact Pagos]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="a27c8227-4797-4e3b-9ad1-ce53c2e89d8b">
      <ID>KPI 7</ID>
      <Name>KPI Tasa de Flete</Name>
      <Value>[Measures].[Valor Flete] / [Measures].[Valor Pago]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="89a90772-a13d-4852-85dc-03495822d65a">
      <ID>KPI 8</ID>
      <Name>KPI Total de Pedidos</Name>
      <Value>[Measures].[Recuento Fact Ventas y Logistica]</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="daad6e84-306e-45f2-9223-9467847d42a0">
      <ID>KPI 9</ID>
      <Name>KPI Tiempo Promedio de Entrega</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Dias Total Entrega] / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="fd918686-216a-4551-9962-2b60c15689ef">
      <ID>KPI 10</ID>
      <Name>KPI Dias Despacho Vendedor</Name>
      <Value>IIF(
    [Measures].[Recuento Fact Ventas y Logistica] = 0,
    NULL,
    [Measures].[Dias Despacho Vendedor] / [Measures].[Recuento Fact Ventas y Logistica]
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="1389f7ab-5ecc-4816-ba5b-2afce98c0060">
      <ID>KPI 3</ID>
      <Name>KPI Total Clientes</Name>
      <Value>DistinctCount([Dim Clientes].[Customer Id].[Customer Id].Members)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="8078042f-0d27-405f-a512-a3cd04674bae">
      <ID>KPI 11</ID>
      <Name>KPI Total Vendedores</Name>
      <Value>DistinctCount([Dim Vendedores].[Seller Id].[Seller Id].Members)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="80f63bb8-c78f-4006-851d-befa82e5aa5e">
      <ID>KPI 12</ID>
      <Name>KPI Promedio de Ventas por Vendedor</Name>
      <Value>IIF(
    DistinctCount([Dim Vendedores].[Seller Id].[Seller Id].Members) = 0,
    NULL,
    [Measures].[Monto Total Linea] / DistinctCount([Dim Vendedores].[Seller Id].[Seller Id].Members)
)</Value>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>